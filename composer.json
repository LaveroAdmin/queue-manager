{
    "name": "laveroadmin/queue-manager",
    "description": "Queue and background jobs manager for LaveroAdmin",
    "type": "library",
    "keywords": [
        "lavero-admin",
        "queue",
        "jobs",
        "queue-manager",
        "failed-jobs"
    ],
    "homepage": "https://bespredel.name",
    "license": "MIT",
    "authors": [
        {
            "name": "Aleksandr Kireev",
            "email": "hello@bespredel.name",
            "homepage": "https://bespredel.name"
        }
    ],
    "require": {
        "php": ">=8.1",
        "laveroadmin/laveroadmin": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "LaveroAdmin\\Admin\\QueueManager\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaveroAdmin\\Admin\\QueueManager\\QueueManagerServiceProvider"
            ]
        }
    }
}
